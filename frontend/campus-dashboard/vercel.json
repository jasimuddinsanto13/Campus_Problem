{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://campus-backend-621385987600.asia-south1.run.app/api/$1" },
    { "source": "/accounts/(.*)", "destination": "https://campus-backend-621385987600.asia-south1.run.app/accounts/$1" },
    { "source": "/portal/(.*)", "destination": "https://campus-backend-621385987600.asia-south1.run.app/portal/$1" },
    { "source": "/booking/(.*)", "destination": "https://campus-backend-621385987600.asia-south1.run.app/booking/$1" },
    { "source": "/issues/(.*)", "destination": "https://campus-backend-621385987600.asia-south1.run.app/issues/$1" },
    { "source": "/django-admin/(.*)", "destination": "https://campus-backend-621385987600.asia-south1.run.app/django-admin/$1" },
    { "source": "/static/(.*)", "destination": "https://campus-backend-621385987600.asia-south1.run.app/static/$1" },
    { "source": "/media/(.*)", "destination": "https://campus-backend-621385987600.asia-south1.run.app/media/$1" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
