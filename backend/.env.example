# =============================================================================
# Campus Problem — Environment Variables
# =============================================================================
# Copy this file to .env for local development.
# On PythonAnywhere, set these via the Web tab → Environment variables.
#
# IMPORTANT: In production, DJANGO_SECRET_KEY and DJANGO_DEBUG are required.
# =============================================================================

# --- Django (REQUIRED in production) ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_TIME_ZONE=Asia/Dhaka

# --- Hosts (REQUIRED in production) ---
# Comma-separated list of allowed hostnames.
# PythonAnywhere example:
ALLOWED_HOSTS=yourusername.pythonanywhere.com,localhost,127.0.0.1

# --- Frontend URL (optional, for CORS) ---
# FRONTEND_URL=https://your-frontend-domain.com

# --- Admin passkey (auto-approves admin registrations) ---
# Keep this secret — anyone who knows it can create admin accounts.
ADMIN_PASSKEY=CAMPUS-ADMIN-2026

# --- Database (SQLite3 by default, no config needed) ---
# Django uses db.sqlite3 in the backend directory automatically.
# No DB_NAME, DB_USER, etc. required for SQLite.

# --- Firebase Cloud Messaging (optional) ---
# Path to Firebase service-account JSON for push notifications.
# Without this, the app works fine — just no OS-level push.
# FIREBASE_CRED_PATH=/home/yourusername/backend/serviceAccountKey.json
