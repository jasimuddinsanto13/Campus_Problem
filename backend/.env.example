# Copy this file to .env and adjust the values.

# --- Database (SQLite3 by default) ---
# Django uses db.sqlite3 in the backend directory by default.
# For FastAPI, set DB_PATH to the same file:
# DB_PATH=/path/to/backend/db.sqlite3

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_TIME_ZONE=Asia/Dhaka
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost:8000

# Secret passkey that auto-approves Admin self-registrations.
# Anyone who knows this value can create an admin account — keep it private.
ADMIN_PASSKEY=CAMPUS-ADMIN-2026

# --- FastAPI base URL used by the front-end JavaScript ---
API_BASE_URL=http://127.0.0.1:8001

# --- Firebase Cloud Messaging (optional Web Push) ---
# Path to a Firebase service-account JSON. When unset, Django looks for
# backend/serviceAccountKey.json. Without a credential file push is disabled
# and the app runs exactly the same, minus OS-level notifications.
# FIREBASE_CRED_PATH=C:/path/to/serviceAccountKey.json
# Legacy env var, also honored by booking.fcm for lazy init:
# FCM_SERVICE_ACCOUNT_PATH=C:/path/to/firebase-service-account.json

# --- Cloud Firestore (real-time notifications, caching, chat, sessions) ---
# google-cloud-firestore uses Application Default Credentials.
# On Cloud Run the service account is implicit; locally set this:
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/serviceAccountKey.json

# Optional: prefix all Firestore collection names (multi-tenant isolation).
# FIRESTORE_COLLECTION_PREFIX=

# Optional: enable Firestore as the Django cache backend.
# FIRESTORE_CACHE=1
# FIRESTORE_CACHE_TTL=3600

# Optional: enable Firestore as the Django session backend.
# SESSION_ENGINE=campus_project.firestore_session
