# Copy this file to .env and adjust the values.

# --- MySQL (shared by Django and FastAPI) ---
DB_NAME=campus_problem
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_TIME_ZONE=Asia/Dhaka
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost:8000

# Secret passkey that auto-approves Admin self-registrations.
# Anyone who knows this value can create an admin account — keep it private.
ADMIN_PASSKEY=CAMPUS-ADMIN-2026

# --- FastAPI base URL used by the front-end JavaScript ---
API_BASE_URL=http://127.0.0.1:8001

# --- Firebase Cloud Messaging (optional Web Push) ---
# Path to a Firebase service-account JSON. When unset, Django looks for
# backend/serviceAccountKey.json. Without a credential file push is disabled
# and the app runs exactly the same, minus OS-level notifications.
# FIREBASE_CRED_PATH=C:/path/to/serviceAccountKey.json
# Legacy env var, also honored by booking.fcm for lazy init:
# FCM_SERVICE_ACCOUNT_PATH=C:/path/to/firebase-service-account.json
